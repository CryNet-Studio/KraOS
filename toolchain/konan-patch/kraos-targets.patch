+     * 会和 Kotlin 源码一起走 IR 链接流程，而启动桩必须是已经编译好的机器码。
+     */
+    val kraosExtraObjects get() = targetList("kraosExtraObjects")
+
+    /**
+     * 追加到链接行的裸库标志（`-lc` 之类）。
+     *
+     * 刻意**不**复用 `linkerGccFlags`：那是个无后缀的全局默认键
