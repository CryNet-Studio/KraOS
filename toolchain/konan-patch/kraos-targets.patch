+    val kraosLoadAddress get() = targetString("kraosLoadAddress") ?: "0x100000"
+
+    /** 内核虚拟地址（高半区 VMA），仅用于生成 [KraOSLinkerScript] 默认脚本。 */
+    val kraosVirtualAddress get() = targetString("kraosVirtualAddress") ?: "0xffffffff80000000"
