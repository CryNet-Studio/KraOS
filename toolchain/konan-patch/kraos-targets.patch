+# KraOS targets.
+#
+# Two distinct targets, both reusing Family.LINUX for toolchain/sysroot resolution
+# but taking completely different paths at link time (see KraOSLinker in
+# native/utils/src/org/jetbrains/kotlin/konan/target/Linker.kt):
+#
+#   kraos_kernel  freestanding kernel: no libc startup, no crt*, no dynamic
+#                 linker, custom -T link script and _start entry. Emits a fully
+#                 static ELF with no PT_INTERP.
+#   kraos         user-space KraELF container -- PLACEHOLDER, not implemented yet.
+#
+# BOOTSTRAP CAVEAT: the toolchain below still borrows the same llvm-16-essentials
+# and gcc-8.3 sysroot bundles as linux_x64, and the runtime bitcode under
+# konan/targets/kraos*/native/ is still linux_x64's. So kraos_kernel today links a
+# static ELF that still contains glibc/pthread references. When the self-hosted
+# runtime bitcode lands, drop the crt/sysroot/libs entries and trim
+# kraosKernelExcludedLibs.
+
+# ---------------------------------------------------------------- shared --
+# Host-target keys use suffix "<host>-<target>"; see hostTargetString/hostTargetSuffix
+# (compiler/util-io/.../properties/Properties.kt) -- NOT the bare "<target>" form.
+
+llvmHome.linux_x64-kraos = llvm-16.0.0-x86_64-linux-essentials-80
+llvmHome.linux_x64-kraos_kernel = llvm-16.0.0-x86_64-linux-essentials-80
+targetToolchain.linux_x64-kraos = $gccToolchain.kraos/x86_64-unknown-linux-gnu
+targetToolchain.linux_x64-kraos_kernel = $gccToolchain.kraos_kernel/x86_64-unknown-linux-gnu
+linker.linux_x64-kraos = $llvmHome.linux_x64-kraos/bin/ld.lld
+linker.linux_x64-kraos_kernel = $llvmHome.linux_x64-kraos_kernel/bin/ld.lld
+linkerHostSpecificFlags.linux_x64-kraos =
+linkerHostSpecificFlags.linux_x64-kraos_kernel =
+
+dependencies.linux_x64-kraos = \
+    llvm-16.0.0-x86_64-linux-essentials-80 \
+    x86_64-unknown-linux-gnu-gcc-8.3.0-glibc-2.19-kernel-4.9-2
+dependencies.linux_x64-kraos_kernel = \
+    llvm-16.0.0-x86_64-linux-essentials-80 \
+    x86_64-unknown-linux-gnu-gcc-8.3.0-glibc-2.19-kernel-4.9-2
+
+llvmVersion.linux_x64-kraos = 16
+llvmVersion.linux_x64-kraos_kernel = 16
+
+# ------------------------------------------------------------ kraos_kernel --
+# Freestanding kernel.
+
+targetTriple.kraos_kernel = x86_64-unknown-linux-gnu
+targetCpu.kraos_kernel = x86-64
+# Do NOT add -mgeneral-regs-only: the K/N ABI uses xmm registers.
+targetCpuFeatures.kraos_kernel = +cx8,+fxsr,+mmx,+sse,+sse2,+x87
+
+# -ffreestanding / -fno-builtin tell clang not to assume a hosted libc is around;
+# -fno-stack-protector because the kernel has no __stack_chk_fail.
+clangFlags.kraos_kernel = -cc1 -emit-obj -disable-llvm-optzns -x ir -ffunction-sections -fdata-sections -ffreestanding -fno-builtin
+clangNooptFlags.kraos_kernel = -O1
+clangOptFlags.kraos_kernel = -O3
+clangDebugFlags.kraos_kernel = -O0
+
+dynamicLibraryRelocationMode.kraos_kernel = pic
+staticLibraryRelocationMode.kraos_kernel = pic
+
+gccToolchain.kraos_kernel = x86_64-unknown-linux-gnu-gcc-8.3.0-glibc-2.19-kernel-4.9-2
+targetSysRoot.kraos_kernel = $gccToolchain.kraos_kernel/x86_64-unknown-linux-gnu/sysroot
+libGcc.kraos_kernel = ../../lib/gcc/x86_64-unknown-linux-gnu/8.3.0
+crtFilesLocation.kraos_kernel = usr/lib
+abiSpecificLibraries.kraos_kernel = lib usr/lib ../lib64 lib64 usr/lib64
+dynamicLinker.kraos_kernel = /lib64/ld-linux-x86-64.so.2
+
+kraosFreestanding.kraos_kernel = true
+# ELF 入口是启动桩 _start（GRUB 跳这里）；它再调 Konan_main 进 K/N 运行时。
+kraosEntryPoint.kraos_kernel = _start
+# 16 MiB：OVMF 在 8~9 MiB 附近保留 ACPI NVS 区，镜像与引导堆都不能压进去。
+kraosLoadAddress.kraos_kernel = 0x1000000
+# 引导期把 VMA 放在低地址：借用的 glibc 静态归档（libc.a/libpthread.a）用
+# R_X86_64_32 绝对重定位，放不下 0xffffffff80000000 高半区，会报
+# "relocation R_X86_64_32 out of range"。自研运行时位码落地、静态 libc 被
+# 摘掉之后，把这里改回 0xffffffff80000000 即可切到高半区内核。
+kraosVirtualAddress.kraos_kernel = 0x0
+# 用项目自带的链接脚本：它要保留 .multiboot、.init_array 和 unwind 表，
+# 这些内置默认脚本为了通用性会丢弃或没有覆盖。
+kraosLinkerScript.kraos_kernel = /home/rj/KraOS/KraOS/boot/linker.ld
+# 引导桩是已经汇编好的机器码，走不了 konanc 的 -Xinclude（那个收的是 klib），
+# 由 KraOSLinker 直接追加到链接行。
+kraosExtraObjects.kraos_kernel = /home/rj/KraOS/KraOS/build/entry.o /home/rj/KraOS/KraOS/build/libc_shim.o /home/rj/KraOS/KraOS/build/ifunc_shim.o
+kraosKernelExcludedLibs.kraos_kernel =
+# BOOTSTRAP: 借用的 linux_x64 运行时仍引用 glibc/pthread/C++ ABI 符号，
+# 必须显式点名对应静态库（-L 来自 abiSpecificLibraries）。自研运行时位码
+# 落地后把这一行清空，即可得到零 libc 依赖的纯内核。
+kraosLinkerExtraLibs.kraos_kernel = -lstdc++ -lpthread -ldl -lc -lm
+
+# No -Bdynamic here: KraOSLinker drives ld.lld directly, and -Bdynamic would let it
+# pick shared objects and produce a dynamically linked image.
+linkerKonanFlags.kraos_kernel = --defsym __cxa_demangle=Konan_cxa_demangle --allow-multiple-definition
+linkerOptimizationFlags.kraos_kernel =
+linkerNoDebugFlags.kraos_kernel = -S
+linkerDynamicFlags.kraos_kernel =
+
+abiVersion.kraos_kernel = 1
+
+# ------------------------------------------------------------------ kraos --
+# User-space KraELF container. PLACEHOLDER: KraELF layout and the loader are not
+# designed yet, so this target currently emits a plain (gnu-shaped) ELF.
+
+targetTriple.kraos = x86_64-unknown-linux-gnu
+targetCpu.kraos = x86-64
+targetCpuFeatures.kraos = +cx8,+fxsr,+mmx,+sse,+sse2,+x87
+
+clangFlags.kraos = -cc1 -emit-obj -disable-llvm-optzns -x ir -ffunction-sections -fdata-sections
+clangNooptFlags.kraos = -O1
+clangOptFlags.kraos = -O3
+clangDebugFlags.kraos = -O0
+
+dynamicLibraryRelocationMode.kraos = pic
+staticLibraryRelocationMode.kraos = pic
+
+gccToolchain.kraos = x86_64-unknown-linux-gnu-gcc-8.3.0-glibc-2.19-kernel-4.9-2
+targetSysRoot.kraos = $gccToolchain.kraos/x86_64-unknown-linux-gnu/sysroot
+libGcc.kraos = ../../lib/gcc/x86_64-unknown-linux-gnu/8.3.0
+crtFilesLocation.kraos = usr/lib
+abiSpecificLibraries.kraos = lib usr/lib ../lib64 lib64 usr/lib64
+dynamicLinker.kraos = /lib64/ld-linux-x86-64.so.2
+
+kraosFreestanding.kraos = false
+kraosEntryPoint.kraos = Konan_main
+kraosKraelfBase.kraos = 0x400000
+kraosKraelfMagic.kraos = 0x4b52414f53
+# 引导期与 kraos_kernel 同理：借用的 glibc 静态归档用 R_X86_64_32 绝对重定位，
+# 加载地址必须留在 4G 以下。KraELF 加载器落地后再按容器格式重定。
+kraosLoadAddress.kraos = 0x400000
+kraosVirtualAddress.kraos = 0x0
+kraosLinkerExtraLibs.kraos = -lstdc++ -lpthread -ldl -lc -lm
+
+linkerKonanFlags.kraos = --defsym __cxa_demangle=Konan_cxa_demangle --allow-multiple-definition
+linkerOptimizationFlags.kraos =
+linkerNoDebugFlags.kraos = -S
+linkerDynamicFlags.kraos = -shared
+
+abiVersion.kraos = 1
+
+
