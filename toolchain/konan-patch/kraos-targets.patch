+/**
+ * KraOS 链接器，服务两个目标：
+ *
+ * - **`kraos_kernel`（freestanding 内核）** —— 完全不走 gnu 启动约定：
+ *   不引入 `crt1.o`/`crti.o`/`crtbegin.o`/`crtend.o`/`crtn.o`，不加 `-dynamic-linker`、
+ *   `--sysroot`、`-export-dynamic`、`--eh-frame-hdr`；段布局与入口由 `-T <链接脚本>` 和
+ *   `--entry=<入口符号>` 决定（默认脚本见 [KraOSLinkerScript]，可由
+ *   `kraosLinkerScript` 属性覆盖）。产物是**全静态、无 PT_INTERP** 的 ELF。
+ *
+ * - **`kraos`（KraELF 用户态）** —— 占位实现。`kraosFreestanding=false` 时退化为
+ *   常规 gnu 链接形状，为将来 KraELF 头生成留出退路。
+ *
+ * 与 [GccBasedLinker] 共享工具链查找（`absoluteTargetToolchain`/`absoluteLlvmHome`）与
+ * `ar` 静态归档逻辑，差异全部收在 [finalLinkCommands] 里。
+ */
+class KraOSLinker(targetProperties: KraOSConfigurables)
+    : LinkerFlags(targetProperties), KraOSConfigurables by targetProperties {
+
+    private val ar = if (HostManager.hostIsLinux) {
+        "$absoluteTargetToolchain/bin/ar"
+    } else {
+        "$absoluteTargetToolchain/bin/llvm-ar"
+    }
+    override val libGcc = "$absoluteTargetSysRoot/${super.libGcc}"
+
+    private val specificLibs = abiSpecificLibraries.map { "-L${absoluteTargetSysRoot}/$it" }
+
+    /**
+     * `-T` 链接脚本路径。属性未配置时把 [KraOSLinkerScript] 的默认脚本写进本次链接的临时目录。
+     *
+     * 只在真正需要链接可执行文件时才求值，避免静态库构建凭空产生临时文件。
+     */
+    // 注意：本包里 File 默认解析到 org.jetbrains.kotlin.konan.file.File（Path 包装类，
+    // listFiles/exists 是属性）。这里需要 java.io.File 语义，故全部写全限定名。
+    private val linkerScript: java.io.File by lazy {
+        val configured = kraosLinkerScript
+        if (configured != null) {
+            java.io.File(absolute(configured))
+        } else {
+            KraOSLinkerScript.materialize(
+                directory = tempFilesDir(),
+                targetName = configurables.target.name,
+                entry = kraosEntryPoint,
+                loadAddress = kraosLoadAddress,
+                virtualAddress = kraosVirtualAddress,
+            )
+        }
+    }
+
+    private fun tempFilesDir(): java.io.File {
+        val dir = java.io.File(System.getProperty("java.io.tmpdir"), "kraos-linker-scripts")
+        dir.mkdirs()
+        return dir
+    }
+
+    override fun provideCompilerRtLibrary(libraryName: String, isDynamic: Boolean): String? {
+        require(!isDynamic) { "Dynamic compiler rt libraries are unsupported on KraOS" }
+        // 与 GccBasedLinker 同源：LLVM 11 之后产物名不再带版本后缀。
+        // 与上游不同的一点：找不到就返回 null —— 返回一个不存在的路径会让 ld.lld
+        // 直接以 "file not found" 失败，比缺一个内建库更难排查。
+        val clangdir = java.io.File("$absoluteLlvmHome/lib/clang/").listFiles()?.firstOrNull()?.absolutePath
+            ?: return null
+        val libdir = java.io.File("$clangdir/lib/").listFiles()?.firstOrNull()?.absolutePath
+            ?: return null
+        val versioned = java.io.File("$libdir/libclang_rt.$libraryName-x86_64.a")
+        if (versioned.exists()) return versioned.absolutePath
+        val plain = java.io.File("$libdir/libclang_rt.$libraryName.a")
+        return if (plain.exists()) plain.absolutePath else null
+    }
+
+    override fun filterStaticLibraries(binaries: List<String>) = binaries.filter { it.isUnixStaticLib }
+
+    /** freestanding 模式下剔除 `linkerKonanFlags` 里被 [kraosKernelExcludedLibs] 点名的 `-l`。 */
+    private fun kraosKonanFlags(): List<String> {
+        val excluded = kraosKernelExcludedLibs.map { it.removePrefix("-l") }.toSet()
+        return linkerKonanFlags.filter { flag ->
+            val name = flag.removePrefix("-l")
+            !flag.startsWith("-l") || name !in excluded
+        }
+    }
+
+    override fun LinkerArguments.finalLinkCommands(): List<Command> {
+        if (kind == LinkerOutputKind.STATIC_LIBRARY) {
+            require(sanitizer == null) { "Sanitizers are unsupported on KraOS" }
+            return staticGnuArCommands(ar, executable, objectFiles, libraries)
+        }
+        if (kind == LinkerOutputKind.DYNAMIC_LIBRARY) {
+            error("KraOS does not support dynamic libraries: ${configurables.target}")
+        }
+        require(sanitizer == null) { "Sanitizers are unsupported on KraOS (freestanding)" }
+
+        if (!kraosFreestanding) {
+            // kraos（KraELF）占位路径：gnu 形状，KraELF 头生成落地后替换为真实实现。
+            System.err.println(
+                "warning: target ${configurables.target} produces a plain ELF for now; " +
+                        "KraELF container generation is not implemented yet."
+            )
+        }
+
+        return listOf(Command(absoluteLinker).apply {
+            +"--entry=$kraosEntryPoint"
+            +"-T${linkerScript.absolutePath}"
+            +"--no-dynamic-linker"
+            +"-static"
+            +"-z"
+            +"noexecstack"
+            +"--gc-sections"
+            +"--build-id=sha1"
+            +"-o"
+            +executable
+            // freestanding 不需要 sysroot；但 hosted 占位路径（kraos）必须要：
+            // glibc 的 libpthread_nonshared.a 内含指向 /usr/lib64 的绝对 INPUT()，
+            // 没有 --sysroot 就会去访问宿主机的 /usr/lib64 而找不到文件。
+            if (!kraosFreestanding) +"--sysroot=${absoluteTargetSysRoot}"
+            +"-L$libGcc"
+            +specificLibs
+            +kraosExtraLinkerDirs.map { "-L$it" }
+            // 引导桩等非 Kotlin 目标文件。放在 objectFiles 之后，保证符号解析
+            // 时 Kotlin 侧生成的目标文件已经就位。
+            +kraosExtraObjects.map { java.io.File(it).absolutePath }
+            if (optimize) +linkerOptimizationFlags
+            if (!debug) +linkerNoDebugFlags
+            +objectFiles
+            +libraries
+            +linkerArgs
+            +kraosKonanFlags()
+            +kraosLinkerExtraLibs
+            // freestanding 下仍可能引用编译器内建（__udivti3 等）与 C++ ABI 符号；
+            // 自研运行时位码落地后可从 kraosKernelExcludedLibs 排掉对应 -l。
+            provideCompilerRtLibrary("builtins")?.let { +it }
+            +"-lgcc"
+            +"-lgcc_eh"
+        })
+    }
+}
