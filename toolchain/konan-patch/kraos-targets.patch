+package org.jetbrains.kotlin.konan.target
+
+import java.io.File
+
+/**
+ * KraOS 内核默认链接脚本（`ld.lld -T` 用）。
+ *
+ * 只在 konan.properties **未**提供 `kraosLinkerScript` 时启用：此时脚本由编译器现写到
+ * 临时目录再交给 ld.lld，`kraos_kernel` 因此无需随发行版附带任何额外文件即可链接。
+ * 一旦配置了 `kraosLinkerScript`，用户脚本原样生效，本对象完全不参与。
+ *
+ * 段布局要点：
+ *  - 高半区 VMA（内核虚拟地址）+ 低 LMA（引导器搬运的物理加载地址），二者分离；
+ *  - `.bss` 不占文件空间（NOBITS），内核按 `__bss_start`/`__bss_end` 自行清零；
+ *  - `.interp`/`.dynamic`/`.plt`/`.got` 一并丢弃 —— freestanding 没有动态链接器；
+ *  - `.init_array`/`.fini_array` 显式落段，避免 lld 当作 orphan section 塞到 `.bss` 之后。
+ */
+internal object KraOSLinkerScript {
+
+    /**
+     * 把默认脚本写到 [directory]，返回该文件。
+     *
+     * 文件名带 [targetName]：kraos 与 kraos_kernel 共用同一个临时目录，
+     * 固定文件名会让并发构建互相覆盖对方的布局参数。
+     */
+    fun materialize(directory: File, targetName: String, entry: String, loadAddress: String, virtualAddress: String): File =
+        File(directory, "$targetName.ld").apply { writeText(render(entry, loadAddress, virtualAddress)) }
+
+    fun render(entry: String, loadAddress: String, virtualAddress: String): String =
+        """
+        |/* Generated by KraOSLinkerScript — KraOS freestanding kernel link script.
+        | * Override by setting `kraosLinkerScript` in konan.properties.
+        | */
+        |ENTRY($entry)
+        |
+        |KERNEL_LMA = $loadAddress;
+        |KERNEL_VMA = $virtualAddress;
+        |
+        |SECTIONS
+        |{
+        |    . = KERNEL_LMA + KERNEL_VMA;
+        |    __kernel_start = .;
+        |
+        |    .text : ALIGN(4K)
+        |    {
+        |        KEEP(*(.text.boot))
+        |        *(.text .text.*)
+        |    }
+        |
+        |    .rodata : ALIGN(4K)
+        |    {
+        |        *(.rodata .rodata.*)
+        |    }
+        |
+        |    .init_array : ALIGN(8)
+        |    {
+        |        __init_array_start = .;
+        |        KEEP(*(SORT_BY_INIT_PRIORITY(.init_array.*) SORT_BY_INIT_PRIORITY(.ctors.*)))
+        |        KEEP(*(.init_array .ctors))
+        |        __init_array_end = .;
+        |    }
+        |
+        |    .fini_array : ALIGN(8)
+        |    {
+        |        __fini_array_start = .;
+        |        KEEP(*(SORT_BY_INIT_PRIORITY(.fini_array.*) SORT_BY_INIT_PRIORITY(.dtors.*)))
+        |        KEEP(*(.fini_array .dtors))
+        |        __fini_array_end = .;
+        |    }
+        |
+        |    .rela.iplt : ALIGN(8)
+        |    {
+        |        /* IRELATIVE（ifunc）重定位表。lld 对 glibc 里的 ifunc
+        |         * （memcpy/strlen/memmove 这些多版本实现）只生成 .iplt 桩，
+        |         * 桩体是「jmp *GOT 槽」，GOT 槽留到运行时再填。没有动态链接器
+        |         * 就没有人填，于是跳转直接跳到 0。这里把表留下来，
+        |         * 由引导代码调用 kraos_apply_irel() 逐条执行解析器。 */
+        |        __rela_iplt_start = .;
+        |        KEEP(*(.rela.iplt))
+        |        __rela_iplt_end = .;
+        |    }
+        |
+        |    .data : ALIGN(4K)
+        |    {
+        |        *(.data .data.*)
+        |    }
+        |
+        |    .bss : ALIGN(4K)
+        |    {
+        |        __bss_start = .;
+        |        *(.bss .bss.*)
+        |        *(COMMON)
+        |        . = ALIGN(4K);
+        |        __bss_end = .;
+        |    }
+        |
+        |    __kernel_end = .;
+        |    _end = .;
+        |    PROVIDE(end = .);
+        |
+        |    /DISCARD/ :
+        |    {
+        |        *(.comment)
+        |        *(.note .note.*)
+        |        *(.eh_frame)
+        |        *(.eh_frame_hdr)
+        |        *(.interp)
+        |        *(.dynamic)
+        |        *(.dynsym)
+        |        *(.dynstr)
+        |        *(.hash)
+        |        *(.gnu.hash)
+        |        *(.rela .rela.*)
+        |        *(.rel .rel.*)
+        |        *(.plt .plt.*)
+        |        *(.got .got.*)
+        |        *(.gnu.build.attributes)
+        |    }
+        |}
+        |
+        |ASSERT(ADDR(.text) == KERNEL_LMA + KERNEL_VMA, "kernel .text must land at LMA+VMA")
+        |
+        """.trimMargin()
+}
