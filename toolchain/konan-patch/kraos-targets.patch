+ * 「与 Linux 的差异」全部收敛到下面这些 kraos\* 属性上，不污染上游定义。
+ */
+interface KraOSConfigurables : GccConfigurables {
+    /**
+     * 链接脚本（传给 `ld.lld -T`）。
+     *
+     * 支持绝对路径或相对 konan 依赖目录的路径；**留空则用 [KraOSLinkerScript] 的内置脚本**，
+     * 这样目标无需随发行版附带额外文件即可链接。
+     */
+    val kraosLinkerScript get() = targetString("kraosLinkerScript")
+
+    /** ELF 入口符号名，如 `_start_kraos`。 */
+    val kraosEntryPoint get() = targetString("kraosEntryPoint")!!
+
+    /**
+     * freestanding 开关。true（`kraos_kernel`）时链接不引入 crt 启动文件、
+     * 不加 `--dynamic-linker`/`--sysroot`，产物是无 PT_INTERP 的静态 ELF。
+     *
+     * false（`kraos`）时退化为普通 gnu 链接形状，给 KraELF 占位实现留退路。
+     */
+    val kraosFreestanding get() = targetString("kraosFreestanding")?.toBoolean() ?: true
+
+    /** KraELF 加载基址（十六进制字符串），`kraos` 目标用。 */
+    val kraosKraelfBase get() = targetString("kraosKraelfBase")
+
+    /** KraELF 头魔数（十六进制字符串），`kraos` 目标用。 */
+    val kraosKraelfMagic get() = targetString("kraosKraelfMagic")
+
+    /** 额外传给 `ld.lld` 的 `-L` 搜索目录列表。 */
+    val kraosExtraLinkerDirs get() = targetList("kraosExtraLinkerDirs")
+
+    /**
